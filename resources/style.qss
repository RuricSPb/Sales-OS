QMainWindow {
    background-color: #f5f5f5;
}

QWidget {
    font-family: "Segoe UI";
    font-size: 10pt;
}

QGroupBox {
    font-size: 11pt;
    font-weight: bold;

    border: 1px solid #cfcfcf;
    border-radius: 6px;

    margin-top: 12px;

    padding-top: 12px;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;

    background: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding-left: 6px;
    padding-right: 6px;
}

QLabel {
    color: #222222;
}

QListWidget {
    border: 1px solid #cfcfcf;
    background: white;
}

QToolBar {
    spacing: 6px;
}

QStatusBar {
    background: #efefef;
}